{
  "name": "dsh-section-nav",
  "version": "0.2.5",
  "description": "DSH plugin: a section navigation rail and local chapter bookmarks for the current assistant answer in DeepSeek Harness chat.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ui",
    "sidebar",
    "navigation",
    "bookmarks",
    "section-nav"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jolaaa999/dsh-section-nav.git"
  },
  "author": "jolaaa999",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
